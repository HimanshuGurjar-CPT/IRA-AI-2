{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "node": "20.18.0",
      "distribution": "internal",
      "withoutCredentials": false,
      "env": {
        "CI": "1",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
        },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
